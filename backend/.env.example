# Spider News Now - Backend Configuration
# Copy this file to .env and update with your values

# ============== API Configuration ==============
API_V1_PREFIX=/api/v1
PROJECT_NAME="News Scraper API"
VERSION=2.0.0

# ============== Database Configuration ==============
# Option 1: Use separate DB_* variables (recommended)
DB_HOST=localhost
DB_PORT=3306
DB_USER=spider_news
DB_PASSWORD=your_secure_password_here
DB_NAME=spider_news

# Option 2: Use complete DATABASE_URL (will override separate variables)
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/spider_news

# ============== CORS Configuration ==============
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============== Logging ==============
LOG_LEVEL=INFO

# ============== APScheduler Configuration ==============
SCHEDULER_TIMEZONE=Asia/Shanghai

# ============== Scraper Configuration ==============
SCRAPER_TIMEOUT=60
SCRAPER_MAX_CONCURRENT=6
SCRAPER_DEFAULT_INTERVAL=1800

# ============== Redis Configuration ==============
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Bloom Filter settings (for URL deduplication)
BLOOM_FILTER_CAPACITY=10000000
BLOOM_FILTER_ERROR_RATE=0.001

# ============== Meilisearch Configuration ==============
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=your_meilisearch_master_key
# Advanced settings
MEILISEARCH_BATCH_SIZE=1000
MEILISEARCH_CONTENT_MAX_LENGTH=5000
MEILISEARCH_ASYNC_INDEXING=false

# ============== Storage Configuration ==============
# Options: minio, s3, oss, local
STORAGE_BACKEND=local

# MinIO settings (if using minio backend)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=news-scraper
MINIO_SECURE=false

# AWS S3 settings (if using s3 backend)
# If not set, falls back to MINIO_* settings
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT_URL=  # For S3-compatible services like MinIO

# Aliyun OSS settings (if using oss backend)
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=

# Local storage path (if using local backend)
LOCAL_STORAGE_PATH=./storage

# ============== Twitter API Configuration (Optional) ==============
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# ============== Telegram Configuration (Optional) ==============
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ============== Proxy Configuration (Optional) ==============
HTTP_PROXY=

# ============== Security Configuration ==============
# IMPORTANT: Generate a strong secret key for production!
# Use: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=development_secret_key_change_in_production

# Fernet key for sensitive data encryption (optional)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ============== JWT Authentication ==============
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============== Captcha Configuration ==============
CAPTCHA_EXPIRE_SECONDS=300
CAPTCHA_TOLERANCE=10
CAPTCHA_MAX_ATTEMPTS=3
# Set to true in development to skip captcha verification
SKIP_CAPTCHA=false

# ============== Account Security ==============
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# ============== Export Configuration ==============
EXPORT_DIR=./exports
EXPORT_MAX_ROWS=100000
EXPORT_CLEANUP_DAYS=7

# ============== Data Directory ==============
DATA_DIR=./data
