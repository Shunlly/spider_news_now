# =============================================================
# Spider News Now Backend - Local Development Environment
# =============================================================
# Copy this file to .env for local development
# =============================================================

# =============================================================
# Database Configuration
# =============================================================
# MySQL (recommended, same as production)
DATABASE_URL=mysql+aiomysql://news_user:your_password@localhost:33060/news_scraper
SCHEDULER_JOBSTORE_URL=mysql+pymysql://news_user:your_password@localhost:33060/news_scraper

# PostgreSQL (alternative)
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/news_scraper
# SCHEDULER_JOBSTORE_URL=postgresql+psycopg2://postgres:password@localhost:5432/news_scraper

# =============================================================
# Redis
# =============================================================
REDIS_URL=redis://localhost:63790/0

# =============================================================
# Meilisearch
# =============================================================
MEILISEARCH_URL=http://localhost:7701
MEILISEARCH_API_KEY=your_meilisearch_master_key

# =============================================================
# RustFS Object Storage (S3 Compatible)
# =============================================================
STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=rustfsadmin
MINIO_SECRET_KEY=your_rustfs_password
MINIO_BUCKET=news-scraper
MINIO_SECURE=false

# =============================================================
# Application Security
# =============================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev_secret_key_change_in_production

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=dev_fernet_key_change_in_production

# =============================================================
# Application Settings
# =============================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# =============================================================
# APScheduler Settings
# =============================================================
SCHEDULER_TIMEZONE=Asia/Shanghai

# =============================================================
# Scraper Settings
# =============================================================
DEFAULT_SCRAPER_INTERVAL=1800
SCRAPER_TIMEOUT=300

# =============================================================
# Social Media API Credentials (Optional)
# =============================================================
# TWITTER_BEARER_TOKEN=your_twitter_bearer_token
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
