# Spider News Now - Frontend Configuration
# Copy this file to .env.local and update with your values

# ============== API Configuration ==============
# API server base URL
# - Development: Uses Vite proxy (see vite.config.ts), this is only used for production
# - Production: Set to your backend API URL
VITE_API_BASE_URL=http://localhost:8001/api/v1

# ============== Application Settings ==============
# Application title displayed in browser tab and header
VITE_APP_TITLE=Spider News Now

# ============== WebSocket Configuration ==============
# WebSocket server URL for real-time dashboard updates
# Optional: defaults to window.location.origin with ws:// protocol
# VITE_WS_URL=ws://localhost:8001

# ============== Feature Flags ==============
# Enable/disable specific features (optional)
# VITE_ENABLE_PWA=true
# VITE_ENABLE_ANALYTICS=false

# ============== Development Settings ==============
# These are typically set in .env.development, not .env.local
# VITE_DEV_PROXY_TARGET=http://localhost:8000
