# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/news_scraper

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=development

# Scraper Settings
DEFAULT_SCRAPER_INTERVAL=1800  # seconds (30 minutes)
SCRAPER_TIMEOUT=300  # seconds (5 minutes)

# API Settings
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# APScheduler Settings
SCHEDULER_TIMEZONE=Asia/Shanghai
