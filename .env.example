# =============================================================
# Spider News Now - Production Environment Variables
# =============================================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control!
# =============================================================

# =============================================================
# GitHub Repository (for pulling images from GHCR)
# =============================================================
GITHUB_REPOSITORY=your_github_username/spider_news_now

# =============================================================
# MySQL Database
# =============================================================
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=news_scraper
MYSQL_USER=news_user
MYSQL_PASSWORD=your_secure_db_password_here
MYSQL_PORT=33060

# =============================================================
# Redis
# =============================================================
REDIS_PORT=63790

# =============================================================
# Meilisearch
# =============================================================
MEILI_MASTER_KEY=your_secure_meilisearch_key_here_min_16_chars
MEILI_PORT=7701

# =============================================================
# RustFS Object Storage (S3 Compatible)
# =============================================================
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=your_secure_rustfs_password_here
RUSTFS_API_PORT=9010
RUSTFS_CONSOLE_PORT=9011
MINIO_BUCKET=news-scraper

# =============================================================
# Application Security
# =============================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_secure_secret_key_here

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_encryption_key_here

# =============================================================
# Application Settings
# =============================================================
LOG_LEVEL=WARNING
WORKERS=4

# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# =============================================================
# Social Media API Credentials (Optional)
# =============================================================
# Twitter API
# TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Telegram Bot API
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# =============================================================
# Email Notifications (Optional)
# =============================================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_email_password
# SMTP_FROM=noreply@example.com

# =============================================================
# Monitoring (Optional)
# =============================================================
# SENTRY_DSN=https://xxx@sentry.io/xxx
